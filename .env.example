# Generate a quick key with: openssl rand -hex 32
HEADROOM_PROXY_TOKEN=change-me
EASY_HEADROOM_PORT=8787

# Upstream Headroom image tag. Default `latest` = newest release, [proxy,code] extras,
# nonroot. Pin it (e.g. 0.35-code-nonroot) to stay on a known-good release.
#HEADROOM_IMAGE_TAG=latest
# Tag of the easy-headroom Node service image published to GHCR.
#EASY_HEADROOM_TAG=latest
#TZ=Europe/Paris

# Optimization mode: token, cache, token_mode, cache_mode, token_savings, cost_savings, token_headroom
HEADROOM_MODE=token

# Enable code-aware compression in the proxy
HEADROOM_CODE_AWARE_ENABLED=on

#Set to off to disable anonymous telemetry
#HEADROOM_TELEMETRY=no
