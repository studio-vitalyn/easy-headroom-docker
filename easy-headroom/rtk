#!/bin/sh
# Source of truth for the `rtk` stub mounted into easy-headroom-proxy.
# It is NOT bind-mounted at runtime: docker-compose.yml inlines a copy under
# `configs: rtk-wrapper: content:` so the compose file stays self-contained
# (see INSTALL.md). Edit here, then mirror the change into docker-compose.yml,
# escaping every `$` as `$$` so Compose leaves it for the shell.

case "$1" in

  --version)
    echo "rtk 0.99.0 (headroom-aggregate-proxy)"
    ;;
  gain)
    port="${EASY_HEADROOM_PORT:-8787}"
    if [ -n "$HEADROOM_PROXY_TOKEN" ]; then
      curl -sf -H "X-Headroom-Proxy-Token: $HEADROOM_PROXY_TOKEN" "http://easy-headroom:$port/rtk/aggregate" 2>/dev/null
    else
      curl -sf "http://easy-headroom:$port/rtk/aggregate" 2>/dev/null
    fi
    ;;
  *)
    exit 0
    ;;
esac
